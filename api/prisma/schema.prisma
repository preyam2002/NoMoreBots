generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum UserRuleType {
  WHITELIST
  BLACKLIST
  KEYWORD
  GEO_BLOCK
}

model Tweet {
  id            String   @id
  authorHandle  String
  text          String
  aiProbability Float
  isHidden      Boolean
  createdAt     DateTime @default(now())

  author        Author   @relation(fields: [authorHandle], references: [handle])

  @@index([authorHandle])
  @@index([createdAt])
  @@index([isHidden, createdAt])
}

model Author {
  handle        String   @id
  tweets        Tweet[]
  isFlagged     Boolean  @default(false)
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ClassificationLog {
  id        String   @id @default(uuid())
  tweetId   String
  result    Json
  timestamp DateTime @default(now())

  @@index([tweetId, timestamp])
}

model ExtensionUser {
  id            String           @id @default(uuid())
  clientTokenHash String?        @unique
  createdAt     DateTime         @default(now())
  isPremium     Boolean          @default(false)
  plan          SubscriptionPlan @default(FREE)
  planUpdatedAt DateTime         @default(now())
  requestCount  Int              @default(0)
  lastRequest   DateTime         @default(now())

  // Stats
  tweetsScanned Int              @default(0)
  botsBlocked   Int              @default(0) // Tweets classified as AI

  // Content Filters
  filterEngagement Boolean       @default(false)
  filterRagebait   Boolean       @default(false)
  filterHateSpeech Boolean       @default(false)
  filterRacism     Boolean       @default(false)
  filterVaguePosting Boolean     @default(false)
  filterFearmongering Boolean    @default(false)

  rules         UserRule[]

  @@index([plan])
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([key, windowStart])
  @@index([updatedAt])
}

model UserRule {
  id        String       @id @default(uuid())
  userId    String
  user      ExtensionUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserRuleType
  value     String       // handle (without @), keyword, or region name
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([userId, type])
  @@unique([userId, type, value])
}
