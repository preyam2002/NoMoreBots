{
  "manifest_version": 3,
  "name": "AI Tweet Filter",
  "version": "1.0.0",
  "description": "Hides AI-generated tweets using cloud classification.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-D_oGDyVD.js"
      ],
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "resources": [
        "assets/index.ts-D_oGDyVD.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
